# Modèle de configuration locale. Copier en `.env` et renseigner les valeurs :
#   cp backend/.env.example backend/.env
# Le fichier `.env` n'est pas versionné : il porte des secrets.

# Ne jamais laisser DEBUG=True en production.
DEBUG=True

# Générer une clé propre à chaque installation :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=a-remplacer-par-une-cle-generee

# Hôtes autorisés, séparés par des virgules. Ajouter l'IP de la machine sur le
# réseau local pour que l'application mobile puisse joindre le serveur.
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données.
# En production (Render), DATABASE_URL est fournie automatiquement et remplace
# les quatre variables DB_* ci-dessous — inutile de les renseigner.
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote/base
#
# En local, base MySQL : le mot de passe doit correspondre à celui choisi dans
# setup_mysql.sql.
DB_NAME=mutuelle_sante
DB_USER=mutuelle_app
DB_PASSWORD=a-remplacer
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Production uniquement --------------------------------------------------
# Dossier des justificatifs. Sur Render, le point de montage du disque
# persistant : sans lui, les fichiers déposés sont perdus au déploiement.
# MEDIA_ROOT=/var/data/media

# Origines autorisées à soumettre un formulaire (schéma compris).
# CSRF_TRUSTED_ORIGINS=https://mon-service.onrender.com

# HSTS : à n'activer qu'une fois le domaine définitivement en HTTPS, car le
# navigateur mémorise la consigne pour toute la durée indiquée.
# SECURE_HSTS_SECONDS=31536000

# Compte administrateur créé au premier déploiement, puis ignoré.
# ADMIN_MATRICULE=ADM001
# ADMIN_MOT_DE_PASSE=
